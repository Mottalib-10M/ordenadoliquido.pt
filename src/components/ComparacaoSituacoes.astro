---
/**
 * Le meme salaire brut, compare entre les quatre situations fiscales.
 *
 * C'est la question que se pose reellement quelqu'un arrive sur la page de SA
 * situation : « et si j'etais marie ? », « qu'est-ce que je perds en etant
 * seul ? ». La reponse tenait jusqu'ici dans une liste de liens vers les
 * autres pages, ce qui obligeait a ouvrir quatre onglets et a comparer de tete.
 *
 * Les montants sont calcules par le moteur du site (engine.ts), jamais ecrits
 * a la main : un tableau fige finirait par contredire le simulateur au premier
 * changement de bareme.
 */
import { calculateSalary } from '../lib/engine';
import { SITUACOES } from '../lib/situacoes-data';

interface Props {
  /** Situation de la page courante, mise en evidence dans le tableau. */
  slugAtual: string;
  /** Salaires compares : deux montants frequents suffisent a montrer l'ecart. */
  brutos?: number[];
}
const { slugAtual, brutos = [1500, 2500] } = Astro.props;

const eur = (v: number) =>
  v.toLocaleString('pt-PT', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €';

const linhas = SITUACOES.map((s) => ({
  slug: s.slug,
  label: s.label,
  valores: brutos.map((b) =>
    calculateSalary({
      grossMonthly: b,
      maritalStatus: s.estadoCivil,
      dependents: s.dependentes,
      irsJovem: s.irsJovem,
    }).netMonthly,
  ),
}));

// L'ecart qui interesse : combien la situation courante laisse de plus ou de
// moins que la plus favorable, au salaire median du tableau.
const idx = Math.floor(brutos.length / 2) === brutos.length ? 0 : 0;
const atual = linhas.find((l) => l.slug === slugAtual);
const melhor = linhas.reduce((a, b) => (b.valores[idx] > a.valores[idx] ? b : a));
const diferenca = atual ? Math.round(melhor.valores[idx] - atual.valores[idx]) : 0;
---

<section class="max-w-6xl mx-auto mt-12 border-t border-neutral-200 pt-8">
  <h2 class="text-2xl font-bold text-neutral-900 mb-3">
    A mesma remuneração nas quatro situações
  </h2>
  <p class="text-neutral-700 leading-relaxed mb-5">
    Com o mesmo salário bruto, o líquido muda consoante a situação fiscal declarada, porque
    muda a tabela de retenção aplicada. A contribuição para a Segurança Social, essa, é
    idêntica em todos os casos.
  </p>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b-2 border-neutral-300">
          <th class="py-2 pr-3 text-left font-semibold text-neutral-700">Situação</th>
          {brutos.map((b) => (
            <th class="py-2 px-3 text-right font-semibold text-neutral-700 whitespace-nowrap">
              {eur(b)} brutos
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {linhas.map((l) => (
          <tr class={`border-b border-neutral-200 ${l.slug === slugAtual ? 'bg-primary-50 font-semibold' : ''}`}>
            <td class="py-2 pr-3 text-neutral-800">
              {l.slug === slugAtual ? l.label + ' ← esta página' : l.label}
            </td>
            {l.valores.map((v) => (
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap text-neutral-900">
                {eur(v)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {atual && diferenca > 0 && (
    <p class="text-sm text-neutral-600 leading-relaxed mt-4">
      A {eur(brutos[idx])} brutos, esta situação deixa cerca de {eur(diferenca)} por mês a menos
      do que a mais favorável do quadro, ou perto de {eur(diferenca * 14)} por ano contando os
      catorze meses. A diferença não vem de qualquer benefício adicional, mas apenas da tabela
      de retenção aplicada ao mesmo rendimento.
    </p>
  )}
  {atual && diferenca === 0 && (
    <p class="text-sm text-neutral-600 leading-relaxed mt-4">
      É a situação que deixa o líquido mais elevado a este nível de remuneração. A vantagem
      mede-se sobretudo no acerto anual, onde o quociente conjugal faz descer a taxa marginal
      aplicada ao rendimento do agregado.
    </p>
  )}
</section>
