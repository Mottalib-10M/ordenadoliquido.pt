---
/**
 * Bloc « fontes oficiais », commun aux pages pilier.
 *
 * RECETTE §7 : une page pilier cite au moins trois textes officiels. Sur un
 * sujet fiscal c'est le signal E-E-A-T le plus direct, et le plus facile a
 * verifier par un lecteur : chaque chiffre du site doit pouvoir etre remonte
 * jusqu'au document qui le fixe.
 *
 * Les quatre entites ci-dessous sont celles dont dependent reellement les
 * calculs : l'Autorite fiscale pour les tables de retention, la Securite
 * sociale pour la TSU, la DGERT pour le salaire minimum, l'INE pour les
 * references statistiques.
 */
interface Props {
  /** Phrase d'introduction, adaptee au sujet de la page. */
  intro?: string;
}
const { intro } = Astro.props;

const fontes = [
  {
    url: 'https://info.portaldasfinancas.gov.pt/pt/apoio_contribuinte/tabela_ret_doclib/Pages/default.aspx',
    nome: 'Autoridade Tributária : tabelas de retenção na fonte',
    nota: 'Tabelas mensais de retenção de IRS, escalões e parcelas a abater.',
  },
  {
    url: 'https://www.seg-social.pt/documents/10152/13352/Taxas_contributivas',
    nome: 'Segurança Social : taxas contributivas',
    nota: 'Taxa Social Única: 11 % a cargo do trabalhador, 23,75 % a cargo da entidade empregadora.',
  },
  {
    url: 'https://www.dgert.gov.pt/relacoes-de-trabalho/retribuicao-minima-mensal-garantida',
    nome: 'DGERT : retribuição mínima mensal garantida',
    nota: 'Valor do salário mínimo nacional e respetiva atualização anual.',
  },
  {
    url: 'https://www.ine.pt/',
    nome: 'INE, Instituto Nacional de Estatística',
    nota: 'Ganho médio mensal e distribuição salarial, usados como referência de comparação.',
  },
];
---

<section class="max-w-6xl mx-auto mt-12 border-t border-neutral-200 pt-8">
  <h2 class="text-2xl font-bold text-neutral-900 mb-3">Fontes oficiais</h2>
  <p class="text-sm text-neutral-600 mb-4">
    {intro ?? 'Todos os valores desta página provêm das publicações oficiais abaixo. Nenhum número é retirado de resumos de terceiros.'}
  </p>
  <ul class="space-y-3">
    {fontes.map((f) => (
      <li>
        <a
          href={f.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-600 hover:text-primary-700 font-semibold no-underline hover:underline"
        >
          {f.nome}
        </a>
        <p class="text-sm text-neutral-500 mt-0.5">{f.nota}</p>
      </li>
    ))}
  </ul>
</section>
