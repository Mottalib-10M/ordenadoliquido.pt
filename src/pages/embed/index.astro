---
/**
 * Cible de l'iframe (RECETTE §13).
 *
 * La page /widget/ explique comment integrer le simulateur ; celle-ci est ce
 * que l'iframe charge reellement. Volontairement nue : pas d'en-tete, pas de
 * pied, pas de publicite, et `noindex` — sans quoi Google indexerait deux
 * pages pour un meme contenu et ferait concurrence a la page d'accueil.
 *
 * Le lien d'attribution reste visible : c'est la contrepartie de la gratuite
 * de l'integration, et il ouvre dans une nouvelle fenetre pour ne pas
 * remplacer la page hote.
 */
import '../../styles/global.css';
import SalaryCalculator from '../../components/SalaryCalculator';
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Simulador de Salário Líquido Português | Widget Gratuito</title>
    <meta
      name="description"
      content="Versão incorporável do simulador de salário líquido português: IRS, TSU e subsídios, sem publicidade, para integrar em qualquer site através de um iframe."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://ordenadoliquido.pt/widget/" />
    <style>
      body { margin: 0; padding: 16px; background: #ffffff; }
    </style>
  </head>
  <body>
    <div class="max-w-3xl mx-auto">
      <SalaryCalculator client:idle />
      <div class="mt-6 pt-4 border-t border-neutral-200 text-center">
        <p class="text-xs text-neutral-500">
          Cálculo por
          <a
            href="https://ordenadoliquido.pt/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 hover:text-primary-700 font-semibold"
          >Salário Líquido PT</a>, tabelas de retenção e taxas contributivas oficiais de 2026.
        </p>
      </div>
    </div>
  </body>
</html>
