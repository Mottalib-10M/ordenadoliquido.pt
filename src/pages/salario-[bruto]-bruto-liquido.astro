---
import Layout from "../layouts/Layout.astro";
import SalaryCalculator from "../components/SalaryCalculator";
import { SALARIOS, type SalarioEntry } from "../lib/salarios-data";
import {
  derivedNumbers,
  getBandContext,
  getEscaloesDisplay,
  getIrsExplanation,
  getBudgetBreakdown,
  getTaxTips,
  buildFaqs,
  getSSExplanation,
  getComparisonText,
  getAuthorBox,
  getUniqueComparisons,
  getCareerDescription,
  getRaiseSimulation,
} from "../lib/salary-content";

export function getStaticPaths() {
  return SALARIOS.map((s) => ({
    params: { bruto: s.slug },
    props: { salario: s },
  }));
}

interface Props {
  salario: SalarioEntry;
}

const { salario } = Astro.props;
const d = derivedNumbers(salario);
const bandContext = getBandContext(salario, d);
const escaloes = getEscaloesDisplay(d.escalaoIndex);
const irsExplanation = getIrsExplanation(salario, d);
const budget = getBudgetBreakdown(salario.liquidoMensal);
const tips = getTaxTips(salario, d);
const faqs = buildFaqs(salario, d);
const ssExplanation = getSSExplanation(salario, d);
const comparisonText = getComparisonText(salario, d);
const uniqueComparisons = getUniqueComparisons(salario, d);
const careerDescription = getCareerDescription(salario);
const raiseSimulation = getRaiseSimulation(salario, d);
const author = getAuthorBox();

// Titre 59-60 et description 151-153 caracteres, dans les bornes de la recette
// (§6). Le montant liquide passe par le formateur portugais : toFixed() ecrit
// un point decimal, qui ne correspondrait pas au texte de la page (§4).
const liquidoFmt = salario.liquidoMensal.toLocaleString("pt-PT", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const title = `Sal\u00e1rio ${salario.brutoMensal}\u00a0\u20ac Bruto para L\u00edquido 2026 | IRS, TSU, Subs\u00eddios`;
const description = `Quanto recebe de l\u00edquido com ${salario.brutoMensal}\u00a0\u20ac brutos mensais em Portugal em 2026? O simulador indica ${liquidoFmt}\u00a0\u20ac por m\u00eas, com IRS, TSU e os dois subs\u00eddios inclu\u00eddos.`;

function formatEuro(val: number): string {
  return val.toLocaleString("pt-PT", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " \u20ac";
}

function formatPercent(val: number): string {
  return (val * 100).toFixed(1) + "%";
}

const outrosSalarios = SALARIOS.filter((s) => s.slug !== salario.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Calculadora",
      "item": "https://ordenadoliquido.pt/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": `Sal\u00e1rio ${salario.brutoMensal}\u20ac Bruto`,
      "item": `https://ordenadoliquido.pt/salario-${salario.slug}-bruto-liquido/`
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.pergunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.resposta
    }
  }))
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `Sal\u00e1rio ${salario.brutoMensal}\u20ac Bruto para L\u00edquido em Portugal 2026`,
  "author": {
    "@type": "Organization",
    "name": "Radif Partners",
    "jobTitle": "Editor de calculadoras y guías prácticas",
  },
  "datePublished": "2025-12-15",
  "dateModified": "2026-01-05",
  "publisher": {
    "@type": "Organization",
    "name": "Sal\u00e1rio L\u00edquido PT",
    "url": "https://ordenadoliquido.pt"
  }
};
---

<Layout
  title={title}
  description={description}
  canonical={`/salario-${salario.slug}-bruto-liquido/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Breadcrumb -->
  <div class="bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-neutral-500">
        <a href="/" class="hover:text-primary-600 no-underline">Calculadora</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-neutral-800 font-medium">Sal&aacute;rio {salario.brutoMensal}&euro; Bruto</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative bg-primary-800 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.18]" style="background-image: radial-gradient(circle at 18% 22%, #35a876 0, transparent 45%), radial-gradient(circle at 88% 12%, #ffc72c 0, transparent 38%);" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <div class="max-w-3xl">
        <h1 class="text-3xl md:text-5xl font-extrabold leading-[1.08] text-white">
          {formatEuro(salario.brutoMensal)} brutos<br />
          <span class="text-accent-400">quanto fica l&iacute;quido</span>
        </h1>
        <p class="mt-4 text-lg text-primary-100 leading-relaxed max-w-2xl">
          Com {formatEuro(salario.brutoMensal)} mensais de sal&aacute;rio bruto, recebe cerca de
          <strong class="text-white font-semibold">{formatEuro(salario.liquidoMensal)}</strong> l&iacute;quidos por m&ecirc;s.
          Abaixo, o detalhe de cada desconto e o que isso representa ao ano, sobre catorze meses.
        </p>
      </div>
    </div>
    <div class="regua-bandeira h-1.5" aria-hidden="true"></div>
  </section>

  <!-- Quick Stats Cards -->
  <section class="-mt-6 relative z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">Bruto Mensal</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatEuro(salario.brutoMensal)}</p>
        </div>
        <div class="bg-primary-600 rounded-xl shadow-lg p-5 text-center text-white">
          <p class="text-xs font-semibold text-primary-100 uppercase tracking-wide">L&iacute;quido Mensal</p>
          <p class="text-2xl font-extrabold mt-1">{formatEuro(salario.liquidoMensal)}</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">Reten&ccedil;&atilde;o IRS</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatPercent(salario.retencaoTaxa)}</p>
          <p class="text-xs text-neutral-500 mt-1">{formatEuro(salario.retencaoMensal)}/m&ecirc;s</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">TSU (SS 11%)</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatEuro(salario.tsuTrabalhador)}</p>
          <p class="text-xs text-neutral-500 mt-1">por m&ecirc;s</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center col-span-2 md:col-span-1">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">L&iacute;quido Anual</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatEuro(salario.liquidoAnual)}</p>
          <p class="text-xs text-neutral-500 mt-1">14 meses</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini Simulator -->
  <section class="py-10 md:py-12 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2 text-center">Simule o Seu Sal&aacute;rio de {salario.brutoMensal}&euro;</h2>
      <p class="text-neutral-500 text-center mb-8">
        Ajuste o estado civil, dependentes e IRS Jovem para ver como o l&iacute;quido varia. O simulador usa os escal&otilde;es e tabelas de reten&ccedil;&atilde;o oficiais de 2026.
      </p>
      <SalaryCalculator client:idle />
    </div>
  </section>

  <!-- Tax Breakdown Table -->
  <section class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">Detalhe do C&aacute;lculo, {salario.brutoMensal}&euro; Brutos</h2>

      <div class="bg-white rounded-2xl shadow-lg border border-neutral-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="text-left px-6 py-3 font-semibold text-neutral-700">Componente</th>
              <th class="text-right px-6 py-3 font-semibold text-neutral-700">Mensal</th>
              <th class="text-right px-6 py-3 font-semibold text-neutral-700">Anual (14 meses)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            <tr>
              <td class="px-6 py-3 font-medium text-neutral-800">Sal&aacute;rio Bruto</td>
              <td class="px-6 py-3 text-right text-neutral-800 font-semibold">{formatEuro(salario.brutoMensal)}</td>
              <td class="px-6 py-3 text-right text-neutral-600">{formatEuro(d.brutoAnual)}</td>
            </tr>
            <tr>
              <td class="px-6 py-3 text-neutral-600">Seguran&ccedil;a Social (TSU 11%)</td>
              <td class="px-6 py-3 text-right text-secondary-700 font-semibold">-{formatEuro(salario.tsuTrabalhador)}</td>
              <td class="px-6 py-3 text-right text-secondary-700">-{formatEuro(d.tsuAnual)}</td>
            </tr>
            <tr>
              <td class="px-6 py-3 text-neutral-600">Reten&ccedil;&atilde;o IRS ({formatPercent(salario.retencaoTaxa)})</td>
              <td class="px-6 py-3 text-right text-secondary-700 font-semibold">-{formatEuro(salario.retencaoMensal)}</td>
              <td class="px-6 py-3 text-right text-secondary-700">-{formatEuro(salario.irsAnual)}</td>
            </tr>
            <tr>
              <td class="px-6 py-3 text-neutral-600">Total de Descontos</td>
              <td class="px-6 py-3 text-right text-secondary-700 font-semibold">-{formatEuro(d.descontosTotaisMensal)}</td>
              <td class="px-6 py-3 text-right text-secondary-700">-{formatEuro(d.descontosTotaisAnual)}</td>
            </tr>
            <tr class="bg-primary-50">
              <td class="px-6 py-4 font-bold text-primary-800">Sal&aacute;rio L&iacute;quido</td>
              <td class="px-6 py-4 text-right font-extrabold text-primary-700 text-lg">{formatEuro(salario.liquidoMensal)}</td>
              <td class="px-6 py-4 text-right font-bold text-primary-600">{formatEuro(salario.liquidoAnual)}</td>
            </tr>
            <tr class="bg-neutral-50">
              <td class="px-6 py-3 text-neutral-500 text-xs">Custo Empregador (incl. TSU patronal 23,75%)</td>
              <td class="px-6 py-3 text-right text-neutral-500 text-xs">{formatEuro(salario.custoEmpregadorMensal)}</td>
              <td class="px-6 py-3 text-right text-neutral-500 text-xs">{formatEuro(d.custoEmpregadorAnual)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-neutral-500 mt-3">
        * Valores calculados para trabalhador solteiro, sem dependentes, sem IRS Jovem. Regime geral da Seguran&ccedil;a Social, Continente. Atualizado para 2026.
      </p>
    </div>
  </section>

  <!-- Band Context / Unique SEO Content -->
  <section class="py-10 bg-white border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral max-w-none">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Sal&aacute;rio de {salario.brutoMensal}&euro; Brutos em Portugal, Contexto e An&aacute;lise</h2>
      <p class="text-neutral-700 leading-relaxed">{bandContext}</p>
    </div>
  </section>

  <!-- Career Description -->
  <section class="py-10 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral max-w-none">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Perfil Profissional, Quem Ganha {salario.brutoMensal}&euro; Brutos</h2>
      <p class="text-neutral-700 leading-relaxed">{careerDescription}</p>
    </div>
  </section>

  <!-- Comparison with SMN -->
  <section class="py-10 bg-white border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral max-w-none">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Compara&ccedil;&atilde;o: {salario.brutoMensal}&euro; Brutos vs. Sal&aacute;rio M&iacute;nimo</h2>
      <p class="text-neutral-700 leading-relaxed">{comparisonText}</p>
    </div>
  </section>

  <!-- Unique Comparisons Section -->
  <section class="py-10 bg-white border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral max-w-none">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">An&aacute;lise Detalhada, {salario.brutoMensal}&euro; Brutos em Perspetiva</h2>
      {uniqueComparisons.map((c) => (
        <p class="text-neutral-700 leading-relaxed mb-3">{c.texto}</p>
      ))}
    </div>
  </section>

  <!-- Raise Simulation -->
  <section class="py-10 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Simula&ccedil;&atilde;o de Aumento, Partindo de {salario.brutoMensal}&euro; Brutos</h2>
      <p class="text-neutral-600 mb-6">{raiseSimulation.intro}</p>

      <div class="bg-white rounded-2xl shadow-lg border border-neutral-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="text-left px-4 py-3 font-semibold text-neutral-700">Aumento</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Novo Bruto</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Novo L&iacute;quido</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Ganho/m&ecirc;s</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Ganho/ano</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Taxa Marg.</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            {raiseSimulation.cenarios.map((c) => (
              <tr>
                <td class="px-4 py-2 font-medium text-neutral-800">{c.percentagem}</td>
                <td class="px-4 py-2 text-right text-neutral-600">{c.novoBruto}</td>
                <td class="px-4 py-2 text-right text-primary-700 font-semibold">{c.novoLiquido}</td>
                <td class="px-4 py-2 text-right text-primary-700 font-semibold">{c.ganhoMensal}</td>
                <td class="px-4 py-2 text-right text-primary-700">{c.ganhoAnual}</td>
                <td class="px-4 py-2 text-right text-neutral-500">{c.taxaMarginalEfetiva}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-neutral-500 mt-3">
        * Taxa marginal = percentagem do aumento bruto retida em impostos e contribui&ccedil;&otilde;es. Valores estimados para solteiro sem dependentes.
      </p>
    </div>
  </section>

  <!-- Seguranca Social Explanation -->
  <section class="py-10 bg-white border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral max-w-none">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Seguran&ccedil;a Social (TSU) com {salario.brutoMensal}&euro; Brutos</h2>
      <p class="text-neutral-700 leading-relaxed">{ssExplanation}</p>
    </div>
  </section>

  <!-- How IRS Works - Escaloes -->
  <section class="py-10 md:py-14 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Como Funciona o IRS em Portugal, Escal&otilde;es 2026</h2>
      <p class="text-neutral-700 leading-relaxed mb-6">{irsExplanation}</p>

      <div class="bg-white rounded-2xl shadow-lg border border-neutral-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="text-left px-4 py-3 font-semibold text-neutral-700">Escal&atilde;o</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">De</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">At&eacute;</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Taxa</th>
              <th class="text-right px-4 py-3 font-semibold text-neutral-700">Parcela a Abater</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            {escaloes.map((e) => (
              <tr class={e.isActive ? "bg-primary-50 font-semibold" : ""}>
                <td class={`px-4 py-2 ${e.isActive ? "text-primary-700" : "text-neutral-700"}`}>
                  {e.numero} {e.isActive && <span class="text-xs font-semibold text-primary-700 ml-1">(o seu)</span>}
                </td>
                <td class="px-4 py-2 text-right text-neutral-600">{e.limiteInf}</td>
                <td class="px-4 py-2 text-right text-neutral-600">{e.limiteSup}</td>
                <td class={`px-4 py-2 text-right ${e.isActive ? "text-primary-700" : "text-neutral-800"}`}>{e.taxa}</td>
                <td class="px-4 py-2 text-right text-neutral-500">{e.parcelaAbater}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-neutral-500 mt-3">
        Com {formatEuro(salario.brutoMensal)} brutos ({formatEuro(d.brutoAnual)} anuais), o rendimento colet&aacute;vel de {formatEuro(d.rendimentoColetavel)} enquadra-se no {d.escalaoIndex}.&ordm; escal&atilde;o. O sistema de IRS portugu&ecirc;s &eacute; progressivo: cada escal&atilde;o aplica-se apenas ao rendimento que nele se enquadra, resultando numa taxa efetiva de {formatPercent(d.taxaEfetiva)} (inferior &agrave; taxa marginal de {formatPercent(d.escalaoTaxa)}).
      </p>
    </div>
  </section>

  <!-- Monthly Budget Table -->
  <section class="py-10 md:py-14 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Or&ccedil;amento Mensal Sugerido, {formatEuro(salario.liquidoMensal)} L&iacute;quidos</h2>
      <p class="text-neutral-600 mb-6">
        Com um l&iacute;quido de {formatEuro(salario.liquidoMensal)} mensais (ap&oacute;s descontos de {formatEuro(d.descontosTotaisMensal)} sobre os {formatEuro(salario.brutoMensal)} brutos), a distribui&ccedil;&atilde;o or&ccedil;amental deve adaptar-se &agrave; sua realidade. Sugerimos {formatEuro(salario.liquidoMensal * 0.15)} para poupan&ccedil;a, {formatEuro(salario.liquidoMensal * 0.30)} para habita&ccedil;&atilde;o e o restante distribu&iacute;do pelas categorias essenciais.
      </p>

      <div class="bg-white rounded-2xl shadow-lg border border-neutral-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="text-left px-6 py-3 font-semibold text-neutral-700">Categoria</th>
              <th class="text-center px-6 py-3 font-semibold text-neutral-700">%</th>
              <th class="text-right px-6 py-3 font-semibold text-neutral-700">Valor Mensal</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            {budget.map((b) => (
              <tr>
                <td class="px-6 py-3 text-neutral-700">{b.categoria}</td>
                <td class="px-6 py-3 text-center text-neutral-500">{b.percentagem}</td>
                <td class="px-6 py-3 text-right font-semibold text-neutral-800">{b.valor}</td>
              </tr>
            ))}
            <tr class="bg-primary-50">
              <td class="px-6 py-3 font-bold text-primary-800">Total</td>
              <td class="px-6 py-3 text-center font-bold text-primary-700">100%</td>
              <td class="px-6 py-3 text-right font-extrabold text-primary-700">{formatEuro(salario.liquidoMensal)}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Tax Optimization Tips -->
  <section class="py-10 md:py-14 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">Dicas de Otimiza&ccedil;&atilde;o Fiscal, {salario.brutoMensal}&euro; Brutos</h2>
      <p class="text-neutral-600 mb-8">
        Com {formatEuro(salario.brutoMensal)} brutos, paga {formatEuro(d.descontosTotaisMensal)} em descontos mensais (reten&ccedil;&atilde;o IRS de {formatPercent(salario.retencaoTaxa)} + TSU de 11%). O seu IRS anual estimado &eacute; de {formatEuro(salario.irsAnual)}, no {d.escalaoIndex}.&ordm; escal&atilde;o. Existem formas leg&iacute;timas de reduzir esta carga e aumentar o l&iacute;quido de {formatEuro(salario.liquidoMensal)}.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {tips.map((tip) => (
          <div class="bg-white rounded-xl shadow border border-neutral-200 p-6">
            <h3 class="text-lg font-bold text-neutral-800 mb-2">{tip.titulo}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{tip.descricao}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-10 md:py-14 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-8">Perguntas Frequentes, {salario.brutoMensal}&euro; Brutos</h2>

      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="bg-white rounded-xl shadow border border-neutral-200 overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-neutral-800 hover:text-primary-600 transition-colors flex items-center justify-between list-none">
              <span>{f.pergunta}</span>
              <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-neutral-600 leading-relaxed">
              {f.resposta}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Author E-E-A-T Box -->
  <section class="py-10 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl shadow-lg border border-neutral-200 p-6 md:p-8 flex flex-col md:flex-row gap-6 items-start">
        <div class="w-16 h-16 rounded-full bg-primary-100 flex items-center justify-center flex-shrink-0">
          <span class="text-2xl font-bold text-primary-700">MR</span>
        </div>
        <div>
          <p class="text-sm font-semibold text-neutral-500 uppercase tracking-wide mb-1">Sobre o Autor</p>
          <h3 class="text-lg font-bold text-neutral-900">{author.name}</h3>
          <p class="text-sm text-primary-600 font-medium mb-3">{author.credentials}</p>
          <p class="text-sm text-neutral-600 leading-relaxed">{author.bio}</p>
          <a href="/sobre/" class="inline-block mt-3 text-sm font-semibold text-primary-600 hover:text-primary-700 no-underline">Saber mais &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sources / References -->
  <section class="py-10 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Fontes e Refer&ecirc;ncias Oficiais</h2>
      <p class="text-neutral-600 mb-6">
        Os c&aacute;lculos apresentados nesta p&aacute;gina baseiam-se nas tabelas e legisla&ccedil;&atilde;o oficiais publicadas pelas seguintes entidades portuguesas:
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="mt-1 flex-shrink-0 w-2 h-2 rounded-full bg-primary-500"></span>
          <div>
            <a href="https://www.portaldasfinancas.gov.pt" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 font-semibold no-underline hover:underline">
              Autoridade Tribut&aacute;ria e Aduaneira (Portal das Finan&ccedil;as)
            </a>
            <p class="text-sm text-neutral-500 mt-1">
              Tabelas de reten&ccedil;&atilde;o na fonte de IRS, escal&otilde;es de IRS e legisla&ccedil;&atilde;o fiscal portuguesa.
            </p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 flex-shrink-0 w-2 h-2 rounded-full bg-primary-500"></span>
          <div>
            <a href="https://www.seg-social.pt" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 font-semibold no-underline hover:underline">
              Seguran&ccedil;a Social
            </a>
            <p class="text-sm text-neutral-500 mt-1">
              Taxas contributivas (TSU), regime geral dos trabalhadores por conta de outrem e presta&ccedil;&otilde;es sociais.
            </p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 flex-shrink-0 w-2 h-2 rounded-full bg-primary-500"></span>
          <div>
            <a href="https://www.ine.pt" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 font-semibold no-underline hover:underline">
              INE, Instituto Nacional de Estat&iacute;stica
            </a>
            <p class="text-sm text-neutral-500 mt-1">
              Dados estat&iacute;sticos sobre sal&aacute;rios, emprego e indicadores econ&oacute;micos em Portugal.
            </p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 flex-shrink-0 w-2 h-2 rounded-full bg-primary-500"></span>
          <div>
            <a href="https://www.pordata.pt" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 font-semibold no-underline hover:underline">
              PORDATA, Base de Dados Portugal Contempor&acirc;neo
            </a>
            <p class="text-sm text-neutral-500 mt-1">
              Estat&iacute;sticas sobre remunera&ccedil;&otilde;es, sal&aacute;rio m&iacute;nimo e m&eacute;dio nacional, e indicadores sociais.
            </p>
          </div>
        </li>
      </ul>
      <p class="text-xs text-neutral-500 mt-6">
        * Os valores s&atilde;o estimativas baseadas na legisla&ccedil;&atilde;o em vigor para 2026. Consulte sempre as fontes oficiais para confirma&ccedil;&atilde;o.
      </p>
    </div>
  </section>

  <!-- Cross-links -->
  <section class="py-10 md:py-14 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6 text-center">Outros Sal&aacute;rios, Bruto para L&iacute;quido 2026</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {outrosSalarios.map((s) => (
          <a
            href={`/salario-${s.slug}-bruto-liquido/`}
            class="bg-white rounded-xl border border-neutral-200 p-4 text-center hover:border-primary-400 hover:shadow-md transition-all no-underline group"
          >
            <p class="text-lg font-bold text-neutral-900 group-hover:text-primary-600">{s.brutoMensal}&euro;</p>
            <p class="text-xs text-neutral-500 mt-1">L&iacute;quido: {formatEuro(s.liquidoMensal)}</p>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <h3 class="text-lg font-semibold text-neutral-800 mb-4">Simuladores por Situa&ccedil;&atilde;o Fiscal</h3>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/simulador-solteiro/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">Solteiro</a>
          <a href="/simulador-casado-1-titular/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">Casado 1 Titular</a>
          <a href="/simulador-casado-2-titulares/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">Casado 2 Titulares</a>
          <a href="/simulador-irs-jovem/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">IRS Jovem</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
