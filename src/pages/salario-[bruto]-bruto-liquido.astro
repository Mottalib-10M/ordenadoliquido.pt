---
import Layout from "../layouts/Layout.astro";
import SalaryCalculator from "../components/SalaryCalculator";
import { SALARIOS, type SalarioEntry } from "../lib/salarios-data";

export function getStaticPaths() {
  return SALARIOS.map((s) => ({
    params: { bruto: s.slug },
    props: { salario: s },
  }));
}

interface Props {
  salario: SalarioEntry;
}

const { salario } = Astro.props;

const title = `Salário ${salario.brutoMensal}€ Bruto para Líquido 2026 - Simulador`;
const description = `Descubra quanto recebe de líquido com ${salario.brutoMensal}€ brutos mensais em Portugal em 2026. Salário líquido: ${salario.liquidoMensal.toFixed(2)}€. Simulador com IRS, TSU e subsídios.`;

function formatEuro(val: number): string {
  return val.toLocaleString("pt-PT", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €";
}

function formatPercent(val: number): string {
  return (val * 100).toFixed(1) + "%";
}

const outrosSalarios = SALARIOS.filter((s) => s.slug !== salario.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Calculadora",
      "item": "https://salarioliquido.pt/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": `Salário ${salario.brutoMensal}€ Bruto`,
      "item": `https://salarioliquido.pt/salario-${salario.slug}-bruto-liquido/`
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": salario.faq.map((f) => ({
    "@type": "Question",
    "name": f.pergunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.resposta
    }
  }))
};
---

<Layout
  title={title}
  description={description}
  canonical={`/salario-${salario.slug}-bruto-liquido/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb -->
  <div class="bg-neutral-50 border-b border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-neutral-500">
        <a href="/" class="hover:text-primary-600 no-underline">Calculadora</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <span class="text-neutral-800 font-medium">Salário {salario.brutoMensal}€ Bruto</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white py-10 md:py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">
          Salário {salario.brutoMensal}€ Bruto para Líquido<br />
          <span class="text-primary-200">Portugal 2026</span>
        </h1>
        <p class="text-lg text-primary-100 leading-relaxed">
          Com um salário bruto de <strong>{formatEuro(salario.brutoMensal)}</strong> mensais,
          recebe aproximadamente <strong>{formatEuro(salario.liquidoMensal)}</strong> líquidos
          por mês (solteiro, sem dependentes).
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="-mt-6 relative z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">Bruto Mensal</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatEuro(salario.brutoMensal)}</p>
        </div>
        <div class="bg-primary-600 rounded-xl shadow-lg p-5 text-center text-white">
          <p class="text-xs font-semibold text-primary-100 uppercase tracking-wide">Líquido Mensal</p>
          <p class="text-2xl font-extrabold mt-1">{formatEuro(salario.liquidoMensal)}</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">Retenção IRS</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatPercent(salario.retencaoTaxa)}</p>
        </div>
        <div class="bg-white rounded-xl shadow-lg border border-neutral-200 p-5 text-center">
          <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">Líquido Anual</p>
          <p class="text-2xl font-extrabold text-neutral-900 mt-1">{formatEuro(salario.liquidoAnual)}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Breakdown Table -->
  <section class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">Detalhe do Cálculo - {salario.brutoMensal}€ Brutos</h2>

      <div class="bg-white rounded-2xl shadow-lg border border-neutral-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-neutral-50 border-b border-neutral-200">
              <th class="text-left px-6 py-3 font-semibold text-neutral-700">Componente</th>
              <th class="text-right px-6 py-3 font-semibold text-neutral-700">Mensal</th>
              <th class="text-right px-6 py-3 font-semibold text-neutral-700">Anual</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            <tr>
              <td class="px-6 py-3 font-medium text-neutral-800">Salário Bruto</td>
              <td class="px-6 py-3 text-right text-neutral-800 font-semibold">{formatEuro(salario.brutoMensal)}</td>
              <td class="px-6 py-3 text-right text-neutral-600">{formatEuro(salario.brutoMensal * 14)}</td>
            </tr>
            <tr>
              <td class="px-6 py-3 text-neutral-600">Segurança Social (TSU 11%)</td>
              <td class="px-6 py-3 text-right text-red-600 font-semibold">-{formatEuro(salario.tsuTrabalhador)}</td>
              <td class="px-6 py-3 text-right text-red-500">-{formatEuro(salario.tsuTrabalhador * 14)}</td>
            </tr>
            <tr>
              <td class="px-6 py-3 text-neutral-600">Retenção IRS ({formatPercent(salario.retencaoTaxa)})</td>
              <td class="px-6 py-3 text-right text-red-600 font-semibold">-{formatEuro(salario.retencaoMensal)}</td>
              <td class="px-6 py-3 text-right text-red-500">-{formatEuro(salario.irsAnual)}</td>
            </tr>
            <tr class="bg-primary-50">
              <td class="px-6 py-4 font-bold text-primary-800">Salário Líquido</td>
              <td class="px-6 py-4 text-right font-extrabold text-primary-700 text-lg">{formatEuro(salario.liquidoMensal)}</td>
              <td class="px-6 py-4 text-right font-bold text-primary-600">{formatEuro(salario.liquidoAnual)}</td>
            </tr>
            <tr class="bg-neutral-50">
              <td class="px-6 py-3 text-neutral-500 text-xs">Custo Empregador (incl. TSU patronal 23,75%)</td>
              <td class="px-6 py-3 text-right text-neutral-500 text-xs">{formatEuro(salario.custoEmpregadorMensal)}</td>
              <td class="px-6 py-3 text-right text-neutral-500 text-xs">{formatEuro(salario.custoEmpregadorMensal * 14)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-neutral-400 mt-3">
        * Valores calculados para trabalhador solteiro, sem dependentes, sem IRS Jovem. Regime geral da Segurança Social, Continente.
      </p>
    </div>
  </section>

  <!-- Context / SEO Content -->
  <section class="py-10 bg-white border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-neutral max-w-none">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Salário de {salario.brutoMensal}€ Brutos em Portugal</h2>
      <p class="text-neutral-700 leading-relaxed">{salario.descricao}</p>
      <p class="text-neutral-700 leading-relaxed">{salario.contexto}</p>
    </div>
  </section>

  <!-- Calculator -->
  <section class="py-10 md:py-14 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-2 text-center">Simule o Seu Salário</h2>
      <p class="text-neutral-500 text-center mb-8">
        Ajuste o valor bruto, estado civil e dependentes para ver o resultado exato.
      </p>
      <SalaryCalculator client:idle />
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-10 md:py-14 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-8">Perguntas Frequentes - {salario.brutoMensal}€ Brutos</h2>

      <div class="space-y-6">
        {salario.faq.map((f) => (
          <details class="bg-white rounded-xl shadow border border-neutral-200 overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-neutral-800 hover:text-primary-600 transition-colors flex items-center justify-between list-none">
              <span>{f.pergunta}</span>
              <svg class="w-5 h-5 text-neutral-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-4 text-neutral-600 leading-relaxed">
              {f.resposta}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-links -->
  <section class="py-10 md:py-14 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6 text-center">Outros Salários</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {outrosSalarios.map((s) => (
          <a
            href={`/salario-${s.slug}-bruto-liquido/`}
            class="bg-white rounded-xl border border-neutral-200 p-4 text-center hover:border-primary-400 hover:shadow-md transition-all no-underline group"
          >
            <p class="text-lg font-bold text-neutral-900 group-hover:text-primary-600">{s.brutoMensal}€</p>
            <p class="text-xs text-neutral-500 mt-1">Líquido: {formatEuro(s.liquidoMensal)}</p>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <h3 class="text-lg font-semibold text-neutral-800 mb-4">Simuladores por Situação Fiscal</h3>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/simulador-solteiro/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">Solteiro</a>
          <a href="/simulador-casado-1-titular/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">Casado 1 Titular</a>
          <a href="/simulador-casado-2-titulares/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">Casado 2 Titulares</a>
          <a href="/simulador-irs-jovem/" class="inline-block bg-white border border-neutral-200 rounded-lg px-4 py-2 text-sm font-medium text-neutral-700 hover:border-primary-400 hover:text-primary-600 no-underline transition-colors">IRS Jovem</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
