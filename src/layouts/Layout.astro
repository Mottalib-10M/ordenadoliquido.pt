---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = "https://ordenadoliquido.pt";
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Radif Partners" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content="Ordenado Líquido" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Calculadora de Salário Líquido Portugal 2026",
      "url": siteUrl,
      "description": description,
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "inLanguage": "pt-PT",
      "author": {
        "@type": "Organization",
        "name": "Salário Líquido PT"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Radif Partners",
      "jobTitle": "Especialista em Finanças Pessoais e Fiscalidade",
      "description": "Editora de calculadoras e guias práticos, especializada em finanças pessoais em Portugal. Especializado em IRS, Segurança Social e otimização salarial.",
      "url": "https://ordenadoliquido.pt/sobre/"
    })} />

    <!-- Plausible Analytics -->
    <script defer data-domain="ordenadoliquido.pt" src="https://plausible.io/js/script.js"></script>

    <!--
      Pas de GA4 ici : l'identifiant etait reste a l'etat de gabarit
      (G-XXXXXXXXXX), donc deux requetes vers googletagmanager a chaque page
      pour une mesure qui n'arrivait nulle part. Plausible, ci-dessus, mesure
      l'audience sans cookie ni identifiant personnel.
    -->
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-primary-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-primary-600">Saltar para o conte&uacute;do</a>
    <!-- Header -->
    <header class="bg-white/95 backdrop-blur border-b border-neutral-200 sticky top-0 z-50">
      <!-- Filet aux proportions du drapeau, seule couleur permanente de l'en-tete. -->
      <div class="regua-bandeira h-1" aria-hidden="true"></div>
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 no-underline group">
          <span class="w-9 h-9 rounded-xl bg-primary-700 flex items-center justify-center shadow-sm ring-1 ring-primary-800/20 group-hover:bg-primary-800 transition-colors">
            <span class="text-accent-400 font-bold text-base leading-none">&euro;</span>
          </span>
          <span class="text-[17px] font-bold text-neutral-900 tracking-tight">Sal&aacute;rio L&iacute;quido <span class="text-primary-700">PT</span></span>
        </a>
        <div class="hidden md:flex items-center gap-7 text-sm font-medium">
          <a href="/" class="text-neutral-600 hover:text-primary-700 no-underline relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-accent-400 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left">Calculadora</a>
          <a href="/guides/" class="text-neutral-600 hover:text-primary-700 no-underline relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-accent-400 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left">Guias</a>
          <a href="/faq/" class="text-neutral-600 hover:text-primary-700 no-underline relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-accent-400 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left">FAQ</a>
          <a href="/legal/" class="text-neutral-600 hover:text-primary-700 no-underline relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-accent-400 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left">Avisos Legais</a>
          <a href="/privacidade/" class="text-neutral-600 hover:text-primary-700 no-underline relative py-1 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-accent-400 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left">Privacidade</a>
        </div>
        <!-- Mobile hamburger menu -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-neutral-100 transition-colors"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 text-neutral-600 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>
      <!-- Mobile menu panel -->
      <div
        id="mobile-menu"
        class="md:hidden hidden border-t border-neutral-200 bg-white shadow-lg"
      >
        <div class="px-4 py-3 space-y-1">
          <a href="/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-primary-50 hover:text-primary-800 no-underline transition-colors">Calculadora</a>
          <a href="/guides/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-primary-50 hover:text-primary-800 no-underline transition-colors">Guias</a>
          <a href="/faq/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-primary-50 hover:text-primary-800 no-underline transition-colors">FAQ</a>
          <a href="/legal/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-primary-50 hover:text-primary-800 no-underline transition-colors">Avisos Legais</a>
          <a href="/privacidade/" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-primary-50 hover:text-primary-800 no-underline transition-colors">Privacidade</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-neutral-900 text-neutral-400 mt-16">
      <div class="regua-bandeira h-1" aria-hidden="true"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
          <div>
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-8 h-8 rounded-lg bg-primary-700 flex items-center justify-center">
                <span class="text-accent-400 font-bold text-sm leading-none">&euro;</span>
              </span>
              <h3 class="text-white font-bold text-lg m-0">Sal&aacute;rio L&iacute;quido PT</h3>
            </div>
            <p class="text-sm leading-relaxed">
              Calculadora gratuita de sal&aacute;rio l&iacute;quido para Portugal.
              Valores atualizados para 2026 com escal&otilde;es de IRS, TSU e dedu&ccedil;&otilde;es.
            </p>
          </div>
          <div>
            <h4 class="text-accent-400 font-semibold text-xs uppercase tracking-widest mb-4">Liga&ccedil;&otilde;es</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/" class="hover:text-white no-underline text-neutral-400 transition-colors">Calculadora</a></li>
              <li><a href="/guides/" class="hover:text-white no-underline text-neutral-400 transition-colors">Guias</a></li>
              <li><a href="/faq/" class="hover:text-white no-underline text-neutral-400 transition-colors">Perguntas Frequentes</a></li>
              <li><a href="/legal/" class="hover:text-white no-underline text-neutral-400 transition-colors">Avisos Legais</a></li>
              <li><a href="/privacidade/" class="hover:text-white no-underline text-neutral-400 transition-colors">Pol&iacute;tica de Privacidade</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-accent-400 font-semibold text-xs uppercase tracking-widest mb-4">Informa&ccedil;&atilde;o</h4>
            <p class="text-sm leading-relaxed">
              Esta ferramenta &eacute; meramente indicativa. Os valores apresentados s&atilde;o estimativas
              baseadas nos escal&otilde;es e tabelas oficiais de 2026. Consulte sempre um contabilista
              certificado para situa&ccedil;&otilde;es espec&iacute;ficas.
            </p>
          </div>
        </div>
        <div class="border-t border-neutral-800 mt-8 pt-8 text-center text-xs">
          <p>&copy; {new Date().getFullYear()} ordenadoliquido.pt, Todos os direitos reservados.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script is:inline>
      (function() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');
        if (!btn || !menu || !iconOpen || !iconClose) return;
        btn.addEventListener('click', function() {
          const isOpen = !menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          iconOpen.classList.toggle('hidden');
          iconClose.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
        document.addEventListener('click', function(e) {
          if (!btn.contains(e.target) && !menu.contains(e.target)) {
            menu.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      })();
    </script>

    <style is:global>
      @import "../styles/global.css";
    </style>
  </body>
</html>
